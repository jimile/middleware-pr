<div class="mb-6">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
    <a href="/products" class="hover:text-gray-700">Products</a>
    <span>/</span>
    <a href="/products/<%= product.id %>/edit" class="hover:text-gray-700"><%= product.name %></a>
    <span>/</span>
    <span class="text-gray-800">Images</span>
  </div>
  <h1 class="text-2xl font-bold text-gray-800">Manage Images</h1>
</div>

<!-- Add image form -->
<div class="bg-white rounded-lg shadow p-6 mb-6">
  <h2 class="text-lg font-semibold text-gray-700 mb-4">Add Image</h2>
  <form method="POST" action="/products/<%= product.id %>/images" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
    <div class="lg:col-span-2">
      <label class="block text-xs font-medium text-gray-500 mb-1">Image URL *</label>
      <input type="url" name="file_url" required placeholder="https://..."
        class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">View Type</label>
      <select name="view" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
        <option value="">None</option>
        <% viewTypes.forEach(v => { %>
          <option value="<%= v %>"><%= v.charAt(0).toUpperCase() + v.slice(1) %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Alt Text</label>
      <input type="text" name="alt_text" placeholder="Description..."
        class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
    </div>
    <div>
      <button type="submit" class="w-full bg-indigo-600 text-white text-sm rounded px-4 py-2 hover:bg-indigo-700">Add Image</button>
    </div>
  </form>
</div>

<!-- Image gallery -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
  <% if (images.length === 0) { %>
    <p class="text-gray-400 col-span-full text-center py-8">No images yet.</p>
  <% } %>
  <% images.forEach(img => { %>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <div class="aspect-square bg-gray-100">
        <img src="<%= img.file_url %>" alt="<%= img.alt_text || '' %>"
          class="w-full h-full object-cover"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
        <div class="w-full h-full items-center justify-center text-gray-400 text-xs" style="display:none">
          Failed to load
        </div>
      </div>
      <div class="p-3">
        <div class="flex items-center justify-between mb-1">
          <% if (img.view) { %>
            <span class="text-xs bg-gray-100 text-gray-600 rounded px-2 py-0.5"><%= img.view %></span>
          <% } else { %>
            <span class="text-xs text-gray-400">No view type</span>
          <% } %>
          <span class="text-xs text-gray-400">pos: <%= img.position %></span>
        </div>
        <% if (img.alt_text) { %>
          <p class="text-xs text-gray-500 truncate"><%= img.alt_text %></p>
        <% } %>
        <div class="mt-2 text-right">
          <form method="POST" action="/products/<%= product.id %>/images/<%= img.id %>/delete" class="inline">
            <button type="submit" onclick="return confirm('Delete this image?')"
              class="text-xs text-red-500 hover:text-red-700">Delete</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
</div>
