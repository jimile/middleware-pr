<div class="mb-6">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
    <a href="/products" class="hover:text-gray-700">Products</a>
    <span>/</span>
    <a href="/products/<%= product.id %>/edit" class="hover:text-gray-700"><%= product.name %></a>
    <span>/</span>
    <span class="text-gray-800">Pricing Tiers</span>
  </div>
  <h1 class="text-2xl font-bold text-gray-800">Manage Pricing Tiers</h1>
</div>

<!-- Existing tiers -->
<div class="bg-white rounded-lg shadow mb-6">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Min Qty</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Max Qty</th>
        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Unit Price</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Currency</th>
        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Active</th>
        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if (tiers.length === 0) { %>
        <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">No pricing tiers yet.</td></tr>
      <% } %>
      <% tiers.forEach(t => { %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-2">
            <form method="POST" action="/products/<%= product.id %>/pricing/<%= t.id %>/update" id="tier-<%= t.id %>" class="contents">
              <input type="number" name="min_quantity" value="<%= t.min_quantity %>"
                class="w-20 border border-gray-300 rounded px-2 py-1 text-sm">
          </td>
          <td class="px-4 py-2">
            <input type="number" name="max_quantity" value="<%= t.max_quantity || '' %>" placeholder="No max"
              class="w-20 border border-gray-300 rounded px-2 py-1 text-sm">
          </td>
          <td class="px-4 py-2 text-right">
            <input type="number" name="unit_price" value="<%= t.unit_price %>" step="0.01"
              class="w-24 border border-gray-300 rounded px-2 py-1 text-sm text-right">
          </td>
          <td class="px-4 py-2">
            <input type="text" name="currency" value="<%= t.currency %>"
              class="w-16 border border-gray-300 rounded px-2 py-1 text-sm">
          </td>
          <td class="px-4 py-2 text-center">
            <input type="checkbox" name="is_active" <%= t.is_active ? 'checked' : '' %>>
          </td>
          <td class="px-4 py-2 text-right">
            <div class="flex gap-2 justify-end">
              <button type="submit" class="text-xs text-indigo-600 hover:text-indigo-800">Save</button>
            </form>
              <form method="POST" action="/products/<%= product.id %>/pricing/<%= t.id %>/delete" class="inline">
                <button type="submit" onclick="return confirm('Delete this tier?')"
                  class="text-xs text-red-500 hover:text-red-700">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Add tier form -->
<div class="bg-white rounded-lg shadow p-6">
  <h2 class="text-lg font-semibold text-gray-700 mb-4">Add Pricing Tier</h2>
  <form method="POST" action="/products/<%= product.id %>/pricing" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Min Quantity *</label>
      <input type="number" name="min_quantity" required placeholder="1"
        class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Max Quantity</label>
      <input type="number" name="max_quantity" placeholder="No max"
        class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Unit Price ($) *</label>
      <input type="number" name="unit_price" step="0.01" required placeholder="0.00"
        class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Currency</label>
      <input type="text" name="currency" value="NZD" maxlength="3"
        class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
    </div>
    <div>
      <button type="submit" class="w-full bg-indigo-600 text-white text-sm rounded px-4 py-2 hover:bg-indigo-700">Add Tier</button>
    </div>
  </form>
</div>
