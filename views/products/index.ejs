<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">Products <span class="text-sm font-normal text-gray-500">(<%= totalCount %> total)</span></h1>
  <a href="/products/new" class="mt-2 sm:mt-0 inline-block bg-indigo-600 text-white text-sm font-medium rounded px-4 py-2 hover:bg-indigo-700">+ New Product</a>
</div>

<!-- Search & Filters -->
<form method="GET" action="/products" class="bg-white rounded-lg shadow p-4 mb-6">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Search</label>
      <input type="text" name="search" value="<%= search %>" placeholder="Product name..."
        class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Brand</label>
      <select name="brand_id" class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm">
        <option value="">All Brands</option>
        <% brands.forEach(b => { %>
          <option value="<%= b.id %>" <%= filters.brand_id === b.id ? 'selected' : '' %>><%= b.name %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Category</label>
      <select name="category_id" class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm">
        <option value="">All Categories</option>
        <% categories.forEach(c => { %>
          <option value="<%= c.id %>" <%= filters.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Status</label>
      <select name="active" class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm">
        <option value="">All</option>
        <option value="true" <%= filters.active === 'true' ? 'selected' : '' %>>Active</option>
        <option value="false" <%= filters.active === 'false' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>
    <div class="flex items-end gap-2">
      <button type="submit" class="bg-gray-800 text-white text-sm rounded px-4 py-1.5 hover:bg-gray-900">Filter</button>
      <a href="/products" class="text-sm text-gray-500 hover:text-gray-700 py-1.5">Clear</a>
    </div>
  </div>
</form>

<!-- Product Table -->
<div class="bg-white rounded-lg shadow overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Image</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Brand</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Category</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">SKU</th>
        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Base Cost</th>
        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if (products.length === 0) { %>
        <tr><td colspan="8" class="px-4 py-8 text-center text-gray-400">No products found.</td></tr>
      <% } %>
      <% products.forEach(p => { %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-2">
            <% if (p.image_url) { %>
              <img src="<%= p.image_url %>" alt="" class="w-10 h-10 object-cover rounded">
            <% } else { %>
              <div class="w-10 h-10 bg-gray-200 rounded flex items-center justify-center text-gray-400 text-xs">--</div>
            <% } %>
          </td>
          <td class="px-4 py-2 font-medium text-gray-800">
            <a href="/products/<%= p.id %>/edit" class="hover:text-indigo-600"><%= p.name %></a>
          </td>
          <td class="px-4 py-2 text-gray-600"><%= p.brands ? p.brands.name : '--' %></td>
          <td class="px-4 py-2 text-gray-600"><%= p.categories ? p.categories.name : '--' %></td>
          <td class="px-4 py-2 text-gray-500 font-mono text-xs"><%= p.sku || '--' %></td>
          <td class="px-4 py-2 text-right text-gray-700"><%= p.base_cost ? '$' + parseFloat(p.base_cost).toFixed(2) : '--' %></td>
          <td class="px-4 py-2 text-center">
            <form method="POST" action="/products/<%= p.id %>/toggle-active" class="inline">
              <button type="submit" title="Click to toggle"
                class="inline-block text-xs font-medium rounded-full px-2.5 py-0.5 cursor-pointer
                  <%= p.is_active ? 'bg-green-100 text-green-700 hover:bg-green-200' : 'bg-gray-100 text-gray-500 hover:bg-gray-200' %>">
                <%= p.is_active ? 'Active' : 'Inactive' %>
              </button>
            </form>
          </td>
          <td class="px-4 py-2 text-right">
            <a href="/products/<%= p.id %>/edit" class="text-indigo-600 hover:text-indigo-800 text-xs font-medium">Edit</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Pagination -->
<% if (totalPages > 1) { %>
  <div class="flex items-center justify-between mt-4 text-sm text-gray-600">
    <div>Page <%= page %> of <%= totalPages %></div>
    <div class="flex gap-2">
      <% if (page > 1) { %>
        <a href="/products?page=<%= page - 1 %>&search=<%= encodeURIComponent(search) %>&brand_id=<%= filters.brand_id %>&category_id=<%= filters.category_id %>&active=<%= filters.active %>"
          class="px-3 py-1 bg-white border rounded hover:bg-gray-50">Prev</a>
      <% } %>
      <% if (page < totalPages) { %>
        <a href="/products?page=<%= page + 1 %>&search=<%= encodeURIComponent(search) %>&brand_id=<%= filters.brand_id %>&category_id=<%= filters.category_id %>&active=<%= filters.active %>"
          class="px-3 py-1 bg-white border rounded hover:bg-gray-50">Next</a>
      <% } %>
    </div>
  </div>
<% } %>
