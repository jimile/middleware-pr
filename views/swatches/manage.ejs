<div class="mb-6">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
    <a href="/products" class="hover:text-gray-700">Products</a>
    <span>/</span>
    <a href="/products/<%= product.id %>/edit" class="hover:text-gray-700"><%= product.name %></a>
    <span>/</span>
    <span class="text-gray-800">Colors</span>
  </div>
  <h1 class="text-2xl font-bold text-gray-800">Manage Color Swatches</h1>
</div>

<!-- Add swatch form -->
<div class="bg-white rounded-lg shadow p-6 mb-6">
  <h2 class="text-lg font-semibold text-gray-700 mb-4">Add New Swatch</h2>
  <form method="POST" action="/products/<%= product.id %>/swatches" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Color</label>
      <input type="color" name="hex" value="#000000" class="w-full h-10 rounded border border-gray-300 cursor-pointer">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Label *</label>
      <input type="text" name="label" required placeholder="e.g. Navy Blue"
        class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Image URL</label>
      <input type="url" name="image_url" placeholder="https://..."
        class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Position</label>
      <input type="number" name="position" value="0"
        class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
    </div>
    <div>
      <button type="submit" class="w-full bg-indigo-600 text-white text-sm rounded px-4 py-2 hover:bg-indigo-700">Add Swatch</button>
    </div>
  </form>
</div>

<!-- Existing swatches -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <% if (swatches.length === 0) { %>
    <p class="text-gray-400 col-span-full text-center py-8">No swatches yet.</p>
  <% } %>
  <% swatches.forEach(s => { %>
    <div class="bg-white rounded-lg shadow p-4">
      <form method="POST" action="/products/<%= product.id %>/swatches/<%= s.id %>/update">
        <div class="flex items-start gap-3 mb-3">
          <div class="w-12 h-12 rounded-full border-2 border-gray-200 flex-shrink-0" style="background-color: <%= s.hex %>"></div>
          <div class="flex-1">
            <input type="text" name="label" value="<%= s.label %>"
              class="w-full border border-gray-300 rounded px-2 py-1 text-sm font-medium">
            <div class="flex items-center gap-2 mt-1">
              <input type="color" name="hex" value="<%= s.hex %>" class="w-8 h-6 rounded border cursor-pointer">
              <span class="text-xs text-gray-400 font-mono"><%= s.hex %></span>
            </div>
          </div>
          <% if (s.image_url) { %>
            <img src="<%= s.image_url %>" alt="" class="w-12 h-12 object-cover rounded">
          <% } %>
        </div>
        <div class="grid grid-cols-2 gap-2 mb-3">
          <div>
            <label class="block text-xs text-gray-400">Image URL</label>
            <input type="url" name="image_url" value="<%= s.image_url || '' %>"
              class="w-full border border-gray-300 rounded px-2 py-1 text-xs">
          </div>
          <div>
            <label class="block text-xs text-gray-400">Position</label>
            <input type="number" name="position" value="<%= s.position %>"
              class="w-full border border-gray-300 rounded px-2 py-1 text-xs">
          </div>
        </div>
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-1 text-xs text-gray-500">
            <input type="checkbox" name="is_active" <%= s.is_active ? 'checked' : '' %>>
            Active
          </label>
          <div class="flex gap-2">
            <button type="submit" class="text-xs text-indigo-600 hover:text-indigo-800">Save</button>
          </div>
        </div>
      </form>
      <form method="POST" action="/products/<%= product.id %>/swatches/<%= s.id %>/delete" class="mt-1 text-right">
        <button type="submit" onclick="return confirm('Delete this swatch?')"
          class="text-xs text-red-500 hover:text-red-700">Delete</button>
      </form>
    </div>
  <% }) %>
</div>
